# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Build and distribution directories
dist/
release/
build/
out/
bin/
obj/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# Environment files (contains DB credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.bak

# Local runtime configurations (stores local DB URL & peripheral IPs)
settings.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS metadata
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Prisma generated files (if any local SQLite DBs or backups are used)
prisma/*.db
prisma/*.db-journal
